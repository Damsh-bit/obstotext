# Copia este archivo a .env.local y completa las claves.

# --- Transcripción (Whisper) ---
# Usa Groq (recomendado: rápido y barato) o OpenAI. Basta con una de las dos claves.
GROQ_API_KEY=
OPENAI_API_KEY=
# Opcional: fuerza el proveedor ("groq" u "openai"). Si no se define, usa Groq cuando hay GROQ_API_KEY.
# TRANSCRIPTION_PROVIDER=groq
# Opcional: modelo de transcripción (por defecto whisper-large-v3 en Groq, whisper-1 en OpenAI).
# TRANSCRIPTION_MODEL=

# --- Respuestas del formulario (Claude) — OPCIONAL ---
# Sin esta clave (modo gratis), la app entrega un prompt listo para pegar en claude.ai,
# que responde el formulario con la cuenta gratuita. Con la clave, la app lo responde sola.
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude (por defecto claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Acceso ---
# Opcional pero recomendado al publicar: si se define, la app pide este código antes de procesar
# (evita que cualquiera con el link gaste tus créditos).
# ACCESS_CODE=
